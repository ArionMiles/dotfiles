{
  "awsAuthRefresh": "aws sso login --profile claude",
  "env": {
    "_ZO_DOCTOR": "0"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(go test:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(golangci-lint:*)",
      "Bash(go build:*)",
      "Bash(go doc:*)",
      "Bash(go mod tidy:*)",
      "Bash(go tool cover:*)",
      "Bash(done)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checkout:*)",
      "Bash(gh pr create:*)",
      "Bash(pytest:*)",
      "Bash(cargo test:*)",
      "Bash(make:*)",
      "Bash(task:*)",
      "Bash(sed:*)",
      "Bash(grep:*)",
      "Bash(jq:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(git show:*)",
      "Bash(tail:*)",
      "Bash(go vet:*)",
      "Bash(mkdir:*)",
      "Bash(pwd:*)",
      "Bash(echo:*)",
      "Bash(file:*)",
      "Bash(acli jira:*)",
      "Bash(git checkout:*)",
      "Bash(gh run:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(go get:*)",
      "Bash(git push:*)",
      "Read(**)"
    ],
    "deny": ["Bash(rm -rf:*)", "Read(**/.env*)"]
  },
  "model": "sonnet",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$DOTFILES/agents/notify.sh 'Claude needs your permission!' Blow"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$DOTFILES/agents/notify.sh 'Claude finished!' Glass"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$DOTFILES/claude/starship-claude --config $DOTFILES/claude/starship.toml"
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "theme": "dark",
  "bypassPermissionsModeAccepted": true
}
