#!/usr/bin/env bash
set -euo pipefail

PR="${1:-}"
if [[ -z "$PR" ]]; then
    echo "Usage: gh pr-landed <PR>"
    exit 1
fi

REPO=$(gh repo view --json nameWithOwner --jq '.nameWithOwner')

auto_merge=$(gh pr view "$PR" --json autoMergeRequest --jq '.autoMergeRequest')
if [[ "$auto_merge" == "null" ]]; then
    echo "gh pr-landed: PR #$PR does not have auto-merge enabled"
    exit 1
fi

echo "Watching required checks for PR #$PR ($REPO)..."

print_failure_summary() {
    echo ""
    echo "Failed checks:"
    gh pr checks "$PR" --required --json name,state,link 2>/dev/null \
        | jq -r '.[] | select(.state == "failure" or .state == "error" or .state == "timed_out" or .state == "cancelled") | "\(.name)\t\(.link)"' \
        | while IFS=$'\t' read -r name link; do
            echo ""
            echo "  Check: $name"
            run_id=$(echo "$link" | sed -E 's|.*/runs/([0-9]+).*|\1|')
            if [[ -n "$run_id" && "$run_id" != "$link" ]]; then
                echo "  Logs:"
                gh run view "$run_id" --log-failed 2>/dev/null || echo "  (could not fetch logs)"
            fi
        done
}

# Phase 1: wait for required checks
while true; do
    checks_json=$(gh pr checks "$PR" --required --json name,state,bucket 2>/dev/null)
    pending=$(echo "$checks_json" | jq '[.[] | select(.bucket == "pending")] | length')

    if [[ "$pending" -eq 0 ]]; then
        failed=$(echo "$checks_json" | jq '[.[] | select(.bucket == "fail")] | length')
        if [[ "$failed" -gt 0 ]]; then
            notify "PR #$PR: auto-merge failed — required checks failed"
            print_failure_summary
            exit 1
        fi
        break
    fi

    echo "$(date '+%H:%M:%S') — $pending check(s) pending, next poll in 30s..."
    sleep 30
done

echo "All required checks passed. Waiting for merge..."

# Phase 2: wait for merge
while true; do
    pr_json=$(gh pr view "$PR" --json state,mergedAt,autoMergeRequest)
    state=$(echo "$pr_json" | jq -r '.state')

    if [[ "$state" == "MERGED" ]]; then
        merged_at=$(echo "$pr_json" | jq -r '.mergedAt')
        notify "PR #$PR: landed"
        echo "PR #$PR merged at $merged_at."
        break
    elif [[ "$state" == "CLOSED" ]]; then
        notify "PR #$PR: closed without merging"
        echo "PR #$PR was closed without being merged."
        exit 1
    fi

    auto_merge_check=$(echo "$pr_json" | jq -r '.autoMergeRequest')
    if [[ "$auto_merge_check" == "null" ]]; then
        notify "PR #$PR: auto-merge was disabled"
        echo "Auto-merge was disabled on PR #$PR."
        exit 1
    fi

    echo "$(date '+%H:%M:%S') — not yet merged, next poll in 30s..."
    sleep 30
done
