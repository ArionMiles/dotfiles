{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "everforest",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "permissions": "prompt",
    "new_location": "launch",
    "image_preview": false,
    "verbosity": "low",
    "grouping": "auto",
    "markdown": "rendered"
  },
  "animations": true,
  "tabs": {
    "indicators": "status",
    "layout": "vertical",
    "scope": "cwd",
    "mode": "auto"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 1
  },
  "keybinds": {
    "leader": "ctrl+x",
    "app.exit": "ctrl+d,<leader>q",
    "session.interrupt": "ctrl+c"
  },
  "debug": {
    "devtools": false
  },
  "prompt": {
    "paste": "full",
    "image_preview": true
  }
}
